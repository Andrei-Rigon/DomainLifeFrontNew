# Copie para .env.local (ignorado pelo git) e preencha.

# Mesmo valor do API_KEY do .env da API.
# Em desenvolvimento (npm run dev) o proxy do Vite manda este token como X-API-Key
# e ele NÃO vai para o navegador.
API_KEY=2fd402bd1438b5fd5902d1c71bfc4d394969f3daff9550f1

# Só se o front chamar a API direto (VITE_API_URL definida, ex.: no Vercel).
# ATENÇÃO: variáveis VITE_* ficam visíveis no JavaScript publicado: qualquer pessoa
# que abrir o site consegue ler esse token.
# VITE_API_URL=https://sua-api
# VITE_API_KEY=banana123.
